    "jsdom": "29.1.1",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "typescript-language-server": "5.3.0",
    "vitest": "4.1.10"
