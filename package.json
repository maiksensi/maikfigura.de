    "autoprefixer": "10.5.4",
    "eslint": "10.8.1",
    "jsdom": "29.1.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "typescript-language-server": "5.3.0",
    "vitest": "4.1.10"
  }
